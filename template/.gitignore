# Secrets
.env
.env.local
*.pem
*.key

# Per-session permission accretion, not curriculum. `.claude/settings.json` is the
# reviewed policy and IS committed; this file is whatever you clicked "allow" on.
.claude/settings.local.json

# Datasets and model artifacts — versioned in Roboflow and MLflow, not git.
# Keep the directories themselves in git, ignore everything that lands in them.
data/*
!data/.gitkeep
datasets/
runs/
mlruns/
*.pt
*.onnx
*.mlpackage
*.tflite
*.pte
*.engine

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# Mobile client (Lesson 05)
node_modules/
app/.expo/
app/dist/
# Generated by `expo prebuild`. Committing them means the next prebuild silently
# discards whatever anyone hand-edited in them.
app/ios/
app/android/

# OS / editor
.DS_Store
.idea/
*.swp
