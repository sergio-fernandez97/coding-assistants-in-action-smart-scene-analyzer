# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Claude Code and the Roboflow MCP server read these from the environment of the
# shell that launches `claude`, not from .env directly. Either export them in your
# shell profile, or source this file before starting:
#
#   set -a && source .env && set +a && claude

# Roboflow — https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=
# Your workspace URL slug, visible at app.roboflow.com/<workspace-slug>
ROBOFLOW_WORKSPACE=

# MLflow (Lesson 03). Local server default; change once hosting is decided.
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Lesson 05: the on-device app ---
#
# There is nothing to put here.
#
# Every variable above is dev-time only: they authenticate you to Roboflow and
# MLflow while you build and train. None of them is a runtime secret, because
# there is no runtime service — the models run on the handset and the app makes
# no network call on the inference path.
#
# The app therefore ships with NO credentials of any kind. If you find yourself
# adding an EXPO_PUBLIC_ variable holding anything but a build flag, stop and ask
# what it is for: anything with that prefix is embedded in the app bundle and
# readable by anyone who installs it, and this app has nothing to authenticate to.
#
# What the app needs instead of configuration is artifacts — the exported models
# in app/assets/models/. Those are produced by the export step in Lesson 03, not
# set here.
